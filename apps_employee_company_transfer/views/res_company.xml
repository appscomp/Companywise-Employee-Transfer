<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="res_company_view_employee_form_inherit" model="ir.ui.view">
        <field name="name">res.company.inherit.form.transfer</field>
        <field name="model">res.company</field>
        <field name="inherit_id" ref="base.view_company_form"/>
        <field name="arch" type="xml">
            <xpath expr="//notebook" position="inside">
                <page string="Employee Transfer" name="employee_transfer">
                    <group>
                        <field name="journal_id" domain="[('company_id', '=', id), ('type', 'not in', ['sale', 'purchase'])]"/>
                        <field name="gratuity_debit_account_id"/>
                        <field name="gratuity_credit_account_id"/>
                    </group>
                </page>
            </xpath>
        </field>
    </record>
</odoo>
