<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <record id="company_company_transfer_tree_views" model="ir.ui.view">
        <field name="name">company.company.list.view</field>
        <field name="model">company.transfer</field>
        <field name="arch" type="xml">
            <list decoration-muted="state in ('cancel', 'reject', 'reverse')" decoration-success="state == 'transfer'">
                <field name="name"/>
                <field name="employee_id"/>
                <field name="requested_date"/>
                <field name="start_date"/>
                <field name="current_company" readonly="1"/>
                <field name="transfer_company"/>
                <field name="transfer_type"/>
                <field name="state" widget="badge"/>
            </list>
        </field>
    </record>

    <record id="company_company_transfer_search_views" model="ir.ui.view">
        <field name="name">company.transfer.search.view</field>
        <field name="model">company.transfer</field>
        <field name="arch" type="xml">
            <search>
                <field name="name"/>
                <field name="employee_id"/>
                <field name="current_company" readonly="1"/>
                <field name="transfer_company"/>
                <filter name="draft" string="Draft" domain="[('state', '=', 'draft')]"/>
                <filter name="to_approve" string="To Approve" domain="[('state', '=', 'submit')]"/>
                <filter name="approved" string="To Transfer" domain="[('state', '=', 'approve')]"/>
                <filter name="transferred" string="Transferred" domain="[('state', 'in', ('transfer', 'probation'))]"/>
                <separator/>
                <filter name="temporary" string="Temporary" domain="[('transfer_type', '=', 'temp')]"/>
                <filter name="permanent" string="Permanent" domain="[('transfer_type', '=', 'permanent')]"/>
                <group>
                    <filter name="group_state" string="Status" context="{'group_by': 'state'}"/>
                    <filter name="group_current_company" string="Current Company" context="{'group_by': 'current_company'}"/>
                    <filter name="group_transfer_company" string="Target Company" context="{'group_by': 'transfer_company'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="company_company_transfer_form_views" model="ir.ui.view">
        <field name="name">company.transfer.form.view</field>
        <field name="model">company.transfer</field>
        <field name="arch" type="xml">
            <form>
                <header>
                    <button name="submit_employee_company_transfer" string="Submit"
                            invisible="state != 'draft'" class="oe_highlight" type="object"/>
                    <button name="approve_employee_company_transfer" string="Approve"
                            invisible="state != 'submit' or not can_approve" class="oe_highlight" type="object"/>
                    <button name="reject_employee_company_transfer" string="Reject"
                            invisible="state != 'submit' or not can_approve" type="object"/>
                    <button name="update_employee_company_transfer" string="Transfer"
                            invisible="state != 'approve' or not can_transfer" class="oe_highlight" type="object"
                            confirm="The employee, contract and user access will be moved now. Continue?"/>
                    <button name="cancel_employee_company_transfer" string="Cancel"
                            invisible="state not in ('draft', 'submit', 'approve')" type="object"/>
                    <button name="set_to_draft" string="Set to Draft"
                            invisible="state not in ('cancel', 'reject')" type="object"/>
                    <button name="employee_probation_notify" string="Probation Request"
                            invisible="state != 'transfer' or transfer_type != 'temp'" type="object"/>
                    <button name="action_confirm_probation" string="Confirm Probation"
                            invisible="state != 'probation'" class="oe_highlight" type="object"/>
                    <button name="reverse_employee_company_transfer" string="Reverse Transfer"
                            invisible="state not in ('transfer', 'probation') or transfer_type != 'temp' or not can_transfer"
                            type="object" confirm="The employee will go back to the original company. Continue?"/>
                    <button name="action_generate_final_payslip" string="Generate Final Payslip" type="object"
                            invisible="not payroll_installed or state not in ('transfer', 'probation') or payslip_generated or not can_transfer"/>
                    <field name="state" widget="statusbar" statusbar_visible="draft,submit,approve,transfer"/>
                </header>
                <sheet>
                    <field name="payroll_installed" invisible="1"/>
                    <field name="payroll_structure_model" invisible="1"/>
                    <field name="can_approve" invisible="1"/>
                    <field name="can_transfer" invisible="1"/>
                    <field name="payslip_generated" invisible="1"/>
                    <field name="record_type" invisible="1"/>
                    <field name="company_id" invisible="1"/>
                    <div class="oe_button_box" name="button_box">
                        <button name="action_open_employee" class="oe_stat_button" icon="fa-user" type="object"
                                invisible="employee_count == 0">
                            <div class="o_field_widget o_stat_info">
                                <span class="o_stat_text">Employee</span>
                            </div>
                            <field name="employee_count" invisible="1"/>
                        </button>
                        <button name="employee_new_contract_create_request" class="oe_stat_button"
                                invisible="employee_count == 0" icon="fa-book" type="object"
                                groups="hr.group_hr_manager">
                            <field name="employee_contract_count" widget="statinfo" string="Contracts"/>
                        </button>
                        <button name="employee_create_leave_request" class="oe_stat_button"
                                invisible="employee_count == 0" icon="fa-calendar-check-o" type="object"
                                groups="hr.group_hr_user">
                            <field name="employee_leave_request" widget="statinfo" string="Leave Requests"/>
                        </button>
                        <button name="employee_new_payslip_create_request" class="oe_stat_button" icon="fa-money"
                                invisible="employee_count == 0 or not payroll_installed" type="object"
                                groups="hr.group_hr_user">
                            <field name="employee_payslip_count" widget="statinfo" string="Payslips"/>
                        </button>
                        <button name="action_open_moves" class="oe_stat_button" icon="fa-bookmark-o" type="object"
                                invisible="move_count == 0" groups="account.group_account_readonly">
                            <field name="move_count" widget="statinfo" string="Journal Entries"/>
                        </button>
                        <button name="employee_leave_allocation_info" class="oe_stat_button" icon="fa-calendar"
                                invisible="employee_count == 0" type="object" groups="hr.group_hr_user">
                            <div class="o_field_widget o_stat_info">
                                <span class="o_stat_value">
                                    <field name="number_of_days"/> / <field name="allocated_days"/>
                                </span>
                                <span class="o_stat_text">Time Off Taken / Allocated</span>
                            </div>
                        </button>
                        <div class="oe_stat_button" invisible="transfer_type != 'temp'">
                            <div class="o_field_widget o_stat_info">
                                <span class="o_stat_value"><field name="employee_notice_period"/></span>
                                <span class="o_stat_text">Days of Transfer</span>
                            </div>
                        </div>
                    </div>
                    <field name="image_field" widget="image" class="oe_avatar m-0"/>
                    <div class="oe_title">
                        <h1><field name="name"/></h1>
                    </div>
                    <group>
                        <group string="Current Company" name="current">
                            <field name="transfer_type" readonly="state != 'draft' or record_type == 'intra'"/>
                            <field name="requested_date" readonly="state != 'draft'"/>
                            <field name="employee_id" options="{'no_create': True}" readonly="state != 'draft'"/>
                            <field name="current_company" readonly="1"/>
                            <field name="current_branch" readonly="1"/>
                            <field name="current_department" readonly="1"/>
                            <field name="current_job" readonly="1"/>
                            <field name="current_grade_id" readonly="1"/>
                            <field name="current_reporting_manager" readonly="1"/>
                            <field name="current_supervisor" readonly="1"/>
                            <field name="current_contract" groups="hr.group_hr_user" readonly="1"/>
                            <field name="responsible"/>
                        </group>
                        <group string="Transferred Company" name="target">
                            <field name="start_date" readonly="state != 'draft'"/>
                            <field name="end_date" readonly="state in ('reverse', 'cancel', 'reject')"
                                   invisible="transfer_type != 'temp'" required="transfer_type == 'temp'"/>
                            <field name="transfer_company" options="{'no_create': True}"
                                   readonly="state != 'draft' or record_type == 'intra'"/>
                            <field name="transfer_branch" options="{'no_create': True}"
                                   domain="[('company_id', '=', transfer_company)]" readonly="state != 'draft'"/>
                            <field name="transfer_department" options="{'no_create': True}"
                                   domain="[('company_id', '=', transfer_company)]" readonly="state != 'draft'"/>
                            <field name="transfer_job" options="{'no_create': True}"
                                   domain="[('company_id', '=', transfer_company)]" readonly="state != 'draft'"/>
                            <field name="transfer_grade_id" options="{'no_create': True}" readonly="state != 'draft'"/>
                            <field name="transfer_reporting_manager" options="{'no_create': True}"
                                   readonly="state != 'draft'"/>
                            <field name="transfer_supervisor" options="{'no_create': True}"
                                   readonly="state != 'draft'" invisible="not employee_id"
                                   required="current_grade_level > 2"/>
                            <field name="current_grade_level" invisible="1"/>
                        </group>
                    </group>
                    <group invisible="not employee_id">
                        <group string="Default Company" name="default_access">
                            <field name="employee_default_company" readonly="1"/>
                            <field name="employee_default_branch" readonly="1"/>
                            <field name="employee_default_company_ids" widget="many2many_tags"
                                   options="{'no_create': True}" readonly="state != 'draft'"/>
                            <field name="employee_default_branch_ids" widget="many2many_tags"
                                   options="{'no_create': True}" readonly="state != 'draft'"/>
                        </group>
                        <group string="Payroll Accounting" name="payroll_accounting" groups="hr.group_hr_user">
                            <field name="employee_current_salary_journal" readonly="1"/>
                            <field name="journal_id" options="{'no_create': True}" readonly="state != 'draft'"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Remarks" name="remarks">
                            <group>
                                <field name="remarks" readonly="state != 'draft'" nolabel="1"
                                       placeholder="Reason of the transfer, notes..."/>
                            </group>
                        </page>
                        <page string="Salary Breakdown" name="salary" groups="hr.group_hr_user">
                            <group>
                                <group string="Current Company">
                                    <field name="employee_current_salary_structure" readonly="1"
                                           invisible="not payroll_installed"/>
                                    <field name="current_employee_basic" readonly="1"/>
                                    <field name="current_employee_housing_allowance" readonly="1"/>
                                    <field name="current_employee_travel_allowance" readonly="1"/>
                                    <field name="current_employee_other_allowance" readonly="1"/>
                                    <field name="current_employee_wage" readonly="1"/>
                                </group>
                                <group string="Transfer Company">
                                    <field name="struct_id" invisible="not payroll_installed"
                                           readonly="state != 'draft'" options="{'no_create': True}"/>
                                    <field name="transfer_employee_basic" readonly="state != 'draft'"/>
                                    <field name="transfer_employee_housing_allowance" readonly="state != 'draft'"/>
                                    <field name="transfer_employee_travel_allowance" readonly="state != 'draft'"/>
                                    <field name="transfer_employee_other_allowance" readonly="state != 'draft'"/>
                                    <field name="transfer_employee_wage" readonly="state != 'draft'"/>
                                </group>
                            </group>
                        </page>
                    </notebook>
                    <chatter/>
                </sheet>
            </form>
        </field>
    </record>

    <record model="ir.actions.act_window" id="action_view_inter_employee_company_transfers">
        <field name="name">Inter-Company Employee Transfers</field>
        <field name="res_model">company.transfer</field>
        <field name="view_mode">list,form</field>
        <field name="view_id" ref="company_company_transfer_tree_views"/>
        <field name="domain">[('record_type', '=', 'inter')]</field>
        <field name="context">{'default_record_type': 'inter'}</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">Create a new inter-company transfer</p>
            <p>Move an employee to another company with an approval workflow.</p>
        </field>
    </record>
    <record model="ir.actions.act_window" id="action_view_intra_employee_company_transfers">
        <field name="name">Intra-Company Employee Transfers</field>
        <field name="res_model">company.transfer</field>
        <field name="view_mode">list,form</field>
        <field name="view_id" ref="company_company_transfer_tree_views"/>
        <field name="domain">[('record_type', '=', 'intra')]</field>
        <field name="context">{'default_record_type': 'intra', 'default_transfer_type': 'permanent'}</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">Create a new intra-company transfer</p>
            <p>Move an employee to another branch, department or job inside the same company.</p>
        </field>
    </record>

    <menuitem id="transfer_parent" parent="hr.menu_hr_root" name="Transfers" sequence="25"
              groups="base.group_user"/>
    <menuitem name="Inter-Company Employee Transfer" id="menu_inter_company_transfer"
              action="action_view_inter_employee_company_transfers"
              parent="apps_employee_company_transfer.transfer_parent" sequence="16"/>
    <menuitem name="Intra-Company Employee Transfer" id="menu_intra_company_transfer"
              action="action_view_intra_employee_company_transfers"
              parent="apps_employee_company_transfer.transfer_parent" sequence="17"/>

    <record id="account_move_view_employee_form_inherit" model="ir.ui.view">
        <field name="name">account.move.inherit.form.transfer</field>
        <field name="model">account.move</field>
        <field name="inherit_id" ref="account.view_move_form"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='payment_reference']" position="after">
                <field name="company_transfer_id" groups="hr.group_hr_user"/>
            </xpath>
        </field>
    </record>
</odoo>
