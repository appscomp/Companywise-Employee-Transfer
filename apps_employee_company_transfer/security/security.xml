<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- multi-company: a transfer is visible from the creating, the current or the target company -->
    <record id="company_transfer_multi_company_rule" model="ir.rule">
        <field name="name">Employee Transfer: multi-company</field>
        <field name="model_id" ref="model_company_transfer"/>
        <field name="domain_force">['|', '|', ('company_id', 'in', company_ids), ('current_company', 'in', company_ids), ('transfer_company', 'in', company_ids)]</field>
    </record>
    <!-- plain employees only see the transfers they requested or where they are the reporting manager -->
    <record id="company_transfer_user_rule" model="ir.rule">
        <field name="name">Employee Transfer: own / managed transfers</field>
        <field name="model_id" ref="model_company_transfer"/>
        <field name="groups" eval="[(4, ref('base.group_user'))]"/>
        <field name="domain_force">['|', '|', '|', ('user_id', '=', user.id), ('responsible.user_id', '=', user.id), ('current_reporting_manager.user_id', '=', user.id), ('transfer_reporting_manager.user_id', '=', user.id)]</field>
    </record>
    <record id="company_transfer_hr_rule" model="ir.rule">
        <field name="name">Employee Transfer: HR sees all</field>
        <field name="model_id" ref="model_company_transfer"/>
        <field name="groups" eval="[(4, ref('hr.group_hr_user'))]"/>
        <field name="domain_force">[(1, '=', 1)]</field>
    </record>
</odoo>
