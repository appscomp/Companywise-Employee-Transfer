<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="0">

        <record id="email_template_request_for_company_company_transfer_submit_new" model="mail.template">
            <field name="name">Company To Company Submitted</field>
            <field name="model_id" ref="apps_employee_company_transfer.model_company_transfer"/>
            <field name="subject">{{ object.record_type == 'inter' and 'Inter-Company' or 'Intra-Company' }} transfer request {{ object.name }} to approve</field>
            <field name="email_from">{{ (user.email_formatted or object.company_id.email_formatted) }}</field>
            <field name="auto_delete" eval="True"/>
            <field name="body_html" type="html">
                <p>Dear Sir / Madam,<br/></p>
                <p><t t-out="'Inter-Company' if object.record_type == 'inter' else 'Intra-Company'"/> transfer
                    <strong><t t-out="object.name"/></strong>
                    requested by <strong><t t-out="object.responsible.name or object.user_id.name or ''"/></strong>
                    is waiting for your approval. Please find the details as mentioned below.
                </p>
                <b>Reference:</b> <t t-out="object.name"/><br/>
                <b>Employee:</b> <t t-out="object.employee_id.name"/><br/>
                <b>Current Company:</b> <t t-out="object.current_company.name"/><br/>
                <b>Transferred Company:</b> <t t-out="object.transfer_company.name"/><br/>
                <b>Previous Reporting Manager:</b> <t t-out="object.current_reporting_manager.name"/><br/>
                <b>Transferred Reporting Manager:</b> <t t-out="object.transfer_reporting_manager.name"/><br/>
                <b>Transferred Date:</b> <t t-out="object.start_date"/><br/>
                <a t-attf-href="{{ ctx.get('url') }}"><button class="btn btn-primary">Open the transfer</button></a>
                <p>Thank you,<br/></p>
                <p>This is a system generated email.</p>
            </field>
        </record>

